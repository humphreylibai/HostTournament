<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     HostTournament Module
     Allows the player to host a tournament in a town that has no
     active tournament, by donating an item from inventory as the prize.

     No Harmony dependency. Pure CampaignBehavior + game menus.
     ============================================================ -->
<Module>
	<Name value="Host Tournament"/>
	<Id value="HostTournament"/>
	<Version value="v1.0.0"/>
	<SingleplayerModule value="true"/>
	<DependedModules>
		<DependedModule Id="Native" DependentVersion="v1.5.5" Optional="false"/>
		<DependedModule Id="SandBoxCore" DependentVersion="v1.5.5" Optional="false"/>
		<DependedModule Id="Sandbox" DependentVersion="v1.5.5" Optional="false"/>
		<DependedModule Id="StoryMode" DependentVersion="v1.5.5" Optional="false"/>
	</DependedModules>
	<SubModules>
		<SubModule>
			<Name value="HostTournamentSubModule"/>
			<DLLName value="HostTournament.dll"/>
			<SubModuleClassType value="HostTournament.HostTournamentSubModule"/>
			<Tags>
				<Tag key="DedicatedServerType" value="none"/>
				<Tag key="IsNoRenderModeElement" value="false"/>
			</Tags>
		</SubModule>
	</SubModules>
</Module>
